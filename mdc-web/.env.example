# =====================================================================================================================
# MDC WEB DU DISPATCH - configuration (copiez ce fichier en .env et remplissez-le ; .env n'est JAMAIS publié)
# =====================================================================================================================

# --- Site -------------------------------------------------------------------------------------------------------------
PORT=3000
# Adresse publique du site (sans / final), telle que les dispatchers la tapent dans leur navigateur
PUBLIC_URL=https://dispatch.example.com
# Secret des sessions : longue chaîne aléatoire (ex. : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=
# Durée d'une session (heures)
SESSION_HOURS=12
# 1 si le site est derrière un proxy (Nginx, Caddy, Cloudflare…) qui gère le HTTPS
TRUST_PROXY=0
# Cookie « Secure » (HTTPS obligatoire) : auto (selon PUBLIC_URL), true ou false
COOKIE_SECURE=auto

# --- Discord OAuth2 (https://discord.com/developers/applications > votre application > OAuth2) -------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Doit être EXACTEMENT l'une des « Redirects » déclarées dans le portail Discord
DISCORD_REDIRECT_URI=https://dispatch.example.com/auth/callback
# Serveur Discord (clic droit sur le serveur > Copier l'identifiant, mode développeur activé)
DISCORD_GUILD_ID=
# Rôle donnant accès au panel (un seul identifiant, ou plusieurs séparés par des virgules)
DISCORD_DISPATCH_ROLE_ID=1562214435886465055
# Facultatif mais conseillé : jeton d'un bot présent sur le serveur (vérification des rôles sans dépendre du jeton
# de l'utilisateur). Sans bot : vérification avec la permission « guilds.members.read » de l'utilisateur.
DISCORD_BOT_TOKEN=
# Revérification du rôle : à chaque page / connexion temps réel au-delà de ROLE_RECHECK_SECONDS, et avant chaque action
# (valider, affecter, écrire…) au-delà de SENSITIVE_RECHECK_SECONDS. Rôle retiré : session fermée.
ROLE_RECHECK_SECONDS=300
SENSITIVE_RECHECK_SECONDS=60

# --- MySQL / MariaDB : LA MÊME base que le serveur FiveM (oxmysql) -----------------------------------------------------
# Conseillé : un utilisateur MySQL dédié au site avec SELECT sur les tables mdc_*, INSERT sur mdc_action_log
# et tous les droits sur mdc_web_sessions (voir README).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mdc_web
MYSQL_PASSWORD=
MYSQL_DATABASE=fivem

# --- Serveur FiveM (ressource rp_mdc) ----------------------------------------------------------------------------------
# API de la ressource : http://IP_DU_SERVEUR_FIVEM:PORT/rp_mdc (port du serveur FiveM, 30120 par défaut)
FIVEM_API_URL=http://127.0.0.1:30120/rp_mdc
# Clé partagée : IDENTIQUE à « set mdc_web_key » dans le server.cfg du serveur FiveM (longue chaîne aléatoire)
FIVEM_API_KEY=
# Adresses autorisées à envoyer les événements du jeu (/bridge/events) : IP du serveur FiveM (séparées par des virgules)
BRIDGE_ALLOWED_IPS=127.0.0.1
# Battement vers le serveur FiveM (secondes) : dispatchers connectés ; sans battement, le jeu repasse en mode normal
HEARTBEAT_SECONDS=15

# --- Avancé (tests uniquement : ne pas modifier en production) ----------------------------------------------------------
DISCORD_API_BASE=https://discord.com/api/v10
DISCORD_AUTHORIZE_URL=https://discord.com/oauth2/authorize
